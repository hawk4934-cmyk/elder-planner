rules_version = '2';
// 엘더플래너 Firestore 보안 규칙
// planners/{plannerId} 문서의 members 배열에 있는 사람만 읽고 쓸 수 있습니다.
// 지금은 본인 uid 하나만 들어 있고, 나중에 공유할 때 다른 장로님 uid를 members에 추가하면 됩니다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /planners/{pid} {
      allow read: if request.auth != null
        && (request.auth.uid == pid || request.auth.uid in resource.data.members);
      allow create: if request.auth != null
        && request.auth.uid == pid
        && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && request.auth.uid == resource.data.owner;

      match /{sub}/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/planners/$(pid)).data.members;
      }
    }
  }
}
